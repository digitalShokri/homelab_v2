# Homelab Monitoring Stack - Environment Variables
# Copy this file to .env and update with your values

# ============================================
# SYSTEM CONFIGURATION
# ============================================
# Your server's IP address
SERVER_IP=192.168.1.100

# Network interface for ntopng to capture (one name, from `ip -br link`).
# The monitoring bridge (br-monitoring) is always captured as well.
NETWORK_INTERFACE=eth0

# User/Group IDs (run 'id' command to find yours)
PUID=1000
PGID=1000

# ============================================
# GRAFANA CONFIGURATION
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_secure_password

# ============================================
# PROMETHEUS CONFIGURATION
# ============================================
# Data retention period
PROMETHEUS_RETENTION=15d

# ============================================
# LOKI CONFIGURATION
# ============================================
# Log retention period (in hours: 720h = 30 days)
LOKI_RETENTION_PERIOD=720h

# ============================================
# JELLYFIN CONFIGURATION
# ============================================
# Published URL for Jellyfin (update with your server IP)
JELLYFIN_PUBLISHED_URL=http://192.168.1.100:8096

# Media directories - UPDATE THESE PATHS
MEDIA_MOVIES=/path/to/your/movies
MEDIA_TV=/path/to/your/tv_shows
MEDIA_MUSIC=/path/to/your/music
MEDIA_PHOTOS=/path/to/your/photos

# ============================================
# OPTIONAL ADD-ONS
# ============================================
# Comma-separated Compose profiles to start. Empty = core stack only.
# Available: n8n  (or use `make n8n-enable` / `make n8n-disable`)
COMPOSE_PROFILES=

# n8n: encrypts stored credentials. Generate once with `openssl rand -hex 32`
# and keep it: changing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=

# ============================================
# NGINX PROXY MANAGER
# ============================================
# Default credentials: admin@example.com / changeme
# Change immediately after first login

# ============================================
# PORTAINER
# ============================================
# Create admin user on first visit

# ============================================
# OPENTELEMETRY COLLECTOR
# ============================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ============================================
# TIMEZONE
# ============================================
TZ=America/New_York
